# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SITE_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/jewellery_store

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Seed / demo admin account (used only by seed script)
SEED_ADMIN_NAME=Store Admin
SEED_ADMIN_EMAIL=admin@gayatrijewellers.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_PHONE=9999999999

SEED_CUSTOMER_NAME=Demo Customer
SEED_CUSTOMER_EMAIL=customer@gayatrijewellers.test
SEED_CUSTOMER_PASSWORD=Customer@12345
SEED_CUSTOMER_PHONE=8888888888

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=20
